# Copia a .env y ajusta. NUNCA commitear .env real.

# Conexión a PostgreSQL (async driver asyncpg)
DATABASE_URL=postgresql+asyncpg://maya:maya@localhost:5432/maya_predice

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:4200

# Entorno: development | production
ENV=development

# Puerto en el que escucha el servidor (por defecto 8000). Debe coincidir con el
# puerto configurado en Coolify ("Ports Exposes").
PORT=8000

# Versión del modelo de predicción usada por defecto
MODEL_VERSION=dixon-coles-v1

# --- Ingesta de datos oficiales ---
# Fuente primaria (openfootball, dominio público, derivada del calendario FIFA).
DATA_SOURCE_URL=https://raw.githubusercontent.com/openfootball/worldcup.json/master/2026/worldcup.json
# Job diario de verificación: hora UTC (06:00 ≈ tras los partidos del día anterior).
SYNC_HOUR_UTC=6
SYNC_MINUTE_UTC=0
# Desactívalo si prefieres programar `python -m app.data.sync` con cron en Coolify.
ENABLE_SCHEDULER=true

# --- Fuentes de plantillas (jugadores/suplentes/entrenadores), consenso multi-fuente ---
# Activa varias para cruzar y dar veracidad. Opciones: apifootball,thesportsdb,wikidata,fixture,remote
# En desarrollo (sin acceso a APIs externas) usa el fixture local:
PLAYER_SOURCES=fixture
# En producción (hosts en la allowlist + keys), recomendado cruzar 3 fuentes:
# PLAYER_SOURCES=apifootball,thesportsdb,wikidata
APIFOOTBALL_KEY=
APIFOOTBALL_HOST=https://v3.football.api-sports.io
THESPORTSDB_KEY=3
# Sportmonks: token (cada consulta se cachea en la DB para no repetir llamadas)
SPAPI_TOKEN=
SPORTMONKS_CACHE_TTL_HOURS=24
# Para usar Sportmonks: PLAYER_SOURCES=sportmonks  (o combinado con otras)
SQUADS_FIXTURE_PATH=app/data/samples/squads_sample.json
SQUADS_REMOTE_URL=

# --- Entrenamiento del modelo (histórico de resultados internacionales) ---
HISTORY_SOURCE_URL=https://raw.githubusercontent.com/martj42/international_results/master/results.csv
HISTORY_SINCE_YEAR=2018
# any = al menos una de las 48 (ratings estables, recomendado); both = solo entre
# las 48 (rápido pero muestra pequeña); all = todos los internacionales
HISTORY_TEAM_FILTER=any
MODEL_DECAY_XI=0.004
# Peso del prior Elo: ancla la fuerza al Elo (predice mejor que el ranking FIFA)
ELO_PRIOR_WEIGHT=2.5

# --- Ajuste de la predicción por disponibilidad de jugadores (bajas/lesiones) ---
ENABLE_AVAILABILITY_ADJUSTMENT=true
AVAILABILITY_ADJ_STRENGTH=0.5

# --- Simulación del torneo (Monte Carlo) ---
SIMULATION_ITERATIONS=5000

# --- Actualización en vivo (recalcula al terminar partidos) ---
ENABLE_LIVE_UPDATES=true
LIVE_POLL_MINUTES=60

# --- Notificaciones por email a suscriptores ---
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=maya-predice <no-reply@tudominio.com>
SMTP_START_TLS=true
SMTP_USE_TLS=false
SITE_URL=https://maya-predice.netlify.app
# URL pública de la API (para el enlace de baja en los emails)
API_PUBLIC_URL=https://api.maya-predice.com/api/v1
